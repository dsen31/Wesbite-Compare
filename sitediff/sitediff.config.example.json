{
  "crawl": {
    "maxPages": 300
  },
  "http": {
    "delayMs": 1000
  },
  "output": {
    "labelA": "Live",
    "labelB": "Staging",
    "dir": "reports"
  },
  "ignore": {
    "extraSelectors": ["#promo-banner", ".live-chat", "[data-testid='recently-viewed']"],
    "extraTextPatterns": [
      { "name": "order-number", "mode": "ignore", "pattern": "Order #\\d+" },
      { "name": "stock-count", "mode": "cosmetic", "pattern": "\\d+ in stock", "flags": "i" }
    ],
    "extraUrlPatterns": ["/tag/", "^/archive/\\d{4}"],
    "skipCategories": []
  }
}
